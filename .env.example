FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=traffic_hub

APP_NAME=비베네
KAKAO_CHAT_URL=http://pf.kakao.com/_uuxgxaX/chat

# Rank server partner API (상품 미리보기 + 순위 자동 추적). 둘 중 하나라도 비면 연동 전체가
# 조용히 꺼지고 수동 순위 입력으로 동작한다. 설정 순서는 docs/RANK_INTEGRATION.md "설정 순서".
# RANK_API_TOKEN = 순위 서버(.env)의 NSR_PARTNER_TOKEN 과 같은 값 — 우리가 만드는 값이 아니다.
# URL 끝에 / 를 붙이지 말 것 (경로는 코드가 붙인다).
RANK_SERVER_URL=https://rank.mbizsquare.com
RANK_API_TOKEN=
# 캠페인 종료 시 순위 서버 슬롯도 삭제할지. 슬롯이 파트너 공용 계정이라 켜면 트리플업 쪽
# 추적까지 끊길 수 있다 — 순위 서버 운영자와 합의 후에만 1 로.
RANK_UNTRACK_ON_STOP=0

# Naver Search Ad API (P4-c). Empty -> dummy data. https://manage.searchad.naver.com > 도구 > API 사용 관리
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# Dev bypass login: set DEV_LOGIN=1 (with FLASK_DEBUG=1) to enable /auth/dev-login?as=user|admin|new
DEV_LOGIN=0

# Kakao Login (Phase 2)
KAKAO_REST_KEY=
KAKAO_REDIRECT_URI=http://127.0.0.1:5000/auth/kakao/callback

# PG (Phase 3, per-order card/transfer payment)
PG_PROVIDER=mock
PG_CLIENT_KEY=
PG_SECRET_KEY=

# Bank transfer account (무통장입금 안내)
BANK_NAME=국민은행
BANK_ACCOUNT=000000-00-000000
BANK_HOLDER=트래픽
