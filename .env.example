FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=traffic_hub

APP_NAME=비베네
KAKAO_CHAT_URL=http://pf.kakao.com/_uuxgxaX/chat

# Rank server partner API (상품 미리보기). Empty -> 미리보기 생략, 수동 입력으로 동작.
# RANK_API_TOKEN 은 rankserver 의 /var/www/tripleup/.env 와 같은 값. 코드에 넣지 말 것.
RANK_SERVER_URL=https://rank.mbizsquare.com
RANK_API_TOKEN=

# Naver Search Ad API (P4-c). Empty -> dummy data. https://manage.searchad.naver.com > 도구 > API 사용 관리
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# Dev bypass login: set DEV_LOGIN=1 (with FLASK_DEBUG=1) to enable /auth/dev-login?as=user|admin|new
DEV_LOGIN=0

# Kakao Login (Phase 2)
KAKAO_REST_KEY=
KAKAO_REDIRECT_URI=http://127.0.0.1:5000/auth/kakao/callback

# PG (Phase 3, per-order card/transfer payment)
PG_PROVIDER=mock
PG_CLIENT_KEY=
PG_SECRET_KEY=

# Bank transfer account (무통장입금 안내)
BANK_NAME=국민은행
BANK_ACCOUNT=000000-00-000000
BANK_HOLDER=트래픽
